# ---------------------------------------------------------------------------
# Copy this file to `.env`. NEVER commit `.env`.
# The whole platform works with this file untouched — every value has a safe,
# offline default. You only edit it if you want real AI models.
# ---------------------------------------------------------------------------

# --- Platform -------------------------------------------------------------
PLATFORM_PORT=4000
# One subdomain per ministry: sante.<base>, finances.<base>, …
# Locally you do not need DNS: http://sante.localhost:4000 already works.
PLATFORM_BASE_DOMAIN=tukhnanutha.com
PLATFORM_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Where each service keeps its own database files.
DATA_DIR=.data

# --- AI -------------------------------------------------------------------
# mock      -> deterministic, offline, no API key, no cost.  DEFAULT.
# openrouter-> real models through https://openrouter.ai
# anthropic -> real models through the Anthropic API
AI_PROVIDER=mock

# Only read when AI_PROVIDER is not "mock". Leave empty otherwise.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

AI_MODEL=anthropic/claude-sonnet-5
AI_EMBEDDING_MODEL=mock-embeddings-v1
# Hard ceiling so a single loop cannot burn a budget.
AI_MAX_CALLS_PER_MINUTE=60

# --- Auth (development identity) -----------------------------------------
# dev-open   -> every request is an authenticated demo citizen. DEFAULT.
# dev-tokens -> requests must carry a signed dev token (see packages/auth).
AUTH_MODE=dev-open
AUTH_DEV_SECRET=change-me-locally-this-is-not-a-production-secret

# --- Events ---------------------------------------------------------------
# memory -> in-process broker. DEFAULT, nothing to install.
# nats   -> external NATS server (adapter present, opt-in only)
EVENT_TRANSPORT=memory
NATS_URL=nats://127.0.0.1:4222

# --- IoT ------------------------------------------------------------------
# Sensor simulator tick, milliseconds.
IOT_SIMULATION_INTERVAL_MS=5000
IOT_SIMULATION_AUTOSTART=true
