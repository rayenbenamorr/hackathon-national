{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@platform/refs": ["packages/refs/src/index.ts"],
      "@platform/contracts": ["packages/contracts/src/index.ts"],
      "@platform/contracts/*": ["packages/contracts/src/*"],
      "@platform/events": ["packages/events/src/index.ts"],
      "@platform/data": ["packages/data/src/index.ts"],
      "@platform/observability": ["packages/observability/src/index.ts"],
      "@platform/auth": ["packages/auth/src/index.ts"],
      "@platform/service-kit": ["packages/service-kit/src/index.ts"],
      "@platform/sdk": ["packages/sdk/src/index.ts"],
      "@platform/ai": ["packages/ai/src/index.ts"],
      "@platform/iot": ["packages/iot/src/index.ts"],
      "@platform/digital-twin": ["packages/digital-twin/src/index.ts"],
      "@platform/geo": ["packages/geo/src/index.ts"],
      "@platform/runtime": ["packages/runtime/src/index.ts"],
      "@platform/testing": ["packages/testing/src/index.ts"],
      "@platform/student-tools": ["packages/student-tools/src/index.ts"],
      "@platform/policies": ["packages/policies/src/index.ts"],
      "@platform/rules": ["packages/rules/src/index.ts"],
      "@platform/scoring": ["packages/scoring/src/index.ts"],
      "@platform/governance": ["packages/governance/src/index.ts"],
      "@services/*": ["services/*/src/index.ts"]
    }
  }
}
